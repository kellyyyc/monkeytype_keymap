{
  "name": "Monkeytype Keymap+",
  "description": "Customise the on-screen keyboard",
  "version": "1.1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://monkeytype.com/*", "https://*.monkeytype.com/*"],
      "js": ["scripts/content_script.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  }
}
